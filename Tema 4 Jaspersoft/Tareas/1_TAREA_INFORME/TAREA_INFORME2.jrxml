<jasperReport name="TAREA_INFORME" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="99880cac-0724-49a9-b44f-51289986fba2">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="IdPedido" forPrompting="false" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
    c.nombre        AS cliente,
    c.direccion,
    c.pais,

    p.id_pedido,
    p.vendedor,
    p.fecha_pedido,
    p.fecha_entrega,
    p.fecha_envio,
    p.forma_envio,
    p.cargo,

    pr.id_producto,
    pr.nombre        AS producto,
    pr.cantidad,
    pr.precio        AS precio_unidad,

    c.descuento      AS descuento,
    (pr.precio * pr.cantidad) * (1 - c.descuento / 100.0) AS precio_con_descuento
FROM pedidos p
JOIN clientes c  ON c.id_cliente = p.id_cliente
JOIN productos pr ON pr.id_pedido = p.id_pedido]]></query>
