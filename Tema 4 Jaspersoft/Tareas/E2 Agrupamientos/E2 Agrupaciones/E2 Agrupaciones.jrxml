	<query language="sql"><![CDATA[SELECT "ADDRESS"."ID",
	"ADDRESS"."FIRSTNAME",
	"ADDRESS"."STREET",
	"ADDRESS"."LASTNAME",
	"ADDRESS"."CITY",
	"DOCUMENT"."TOTAL"
FROM "ADDRESS"
	INNER JOIN "DOCUMENT" ON 
	 "DOCUMENT"."ADDRESSID" = "ADDRESS"."ID"]]></query>
